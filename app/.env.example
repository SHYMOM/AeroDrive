# ==============================================================================
# AeroDrive - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in this directory (app/.env) and fill in your values.
# DO NOT commit your personal '.env' file to any public Git repository.
#
# Obtain your free Telegram API ID and Hash:
# 1. Log into https://my.telegram.org with your Telegram account.
# 2. Go to "API development tools".
# 3. Create a new application (e.g. App title: "AeroDrive", Short name: "aerodrive").
# 4. Copy the numerical "App api_id" and string "App api_hash" below.
# ==============================================================================

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
