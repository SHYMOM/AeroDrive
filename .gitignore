# ==========================
# AeroDrive .gitignore
# ==========================

# --- Flutter / Dart ---
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# Generated files (rebuild with `dart run build_runner build`)
*.g.dart
*.freezed.dart
*.mocks.dart

# --- Android ---
app/android/.gradle/
app/android/local.properties
**/local.properties
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
*.jks
*.keystore
*.apk
*.aab
*.hprof

# --- iOS / macOS ---
app/ios/Pods/
app/ios/.symlinks/
app/macos/Pods/
app/macos/.symlinks/
**/Flutter/ephemeral/
**/Pods/

# --- Web ---
app/web/.dart_tool/

# --- Windows ---
app/windows/flutter/ephemeral/

# --- Linux ---
app/linux/flutter/ephemeral/

# --- Go ---
backend/cmd/server/server
backend/cmd/server/server.exe
backend/*.exe
backend/*.out

# --- Node.js ---
node_modules/
tdlib_npm/node_modules/

# --- Python wheels ---
*.whl
python_telegram-*/

# --- IDE & AI Tooling ---
.idea/
.vscode/
*.swp
*.swo
*~
.history/
.opencode/
.qodo/

# --- Secrets ---
# .env files contain API credentials — NEVER commit these
.env
app/.env
*.key
*.pem
*.p12
secrets/

# --- TDLib native binaries (large, platform-specific) ---
# These should be downloaded/built per-platform, not stored in git.
# But keep the jniLibs directory structure (via .gitkeep files).
app/android/app/src/main/jniLibs/**/*.so
tdlib/

# --- Graphify caches & timestamped backups ---
graphify-out/cache/
graphify-out/[0-9]*/

# --- Temporary & Scratch files ---
test_cache/
app/test_cache/
scratch.txt
app/scratch.txt

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Coverage ---
coverage/
lcov.info

# --- Build outputs ---
*.log
*.tmp
*.bak
AeroDrive_Windows_Portable.zip
go-bin/
